{
  "name": "backend",
  "version": "1.0.0",
  "description": "Pinewood Control API: events, racers and heats in Firestore, with live updates over Socket.IO",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "firebase emulators:exec --project demo-qstored --only auth,firestore \"tsx watch src/server.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:emulators": "firebase emulators:exec --project demo-qstored --only auth,firestore \"vitest run\""
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.1",
    "nanoid": "^5.1.7",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "firebase-tools": "^15.36.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^5.1.0"
  }
}
