# Where the API is (empty: the same address, as with the dev server's proxy)
VITE_API_ORIGIN=
# The address kiosk QR codes point at (empty: this one)
VITE_QR_PREFIX=
# The qstored Firebase project's web API key
VITE_FIREBASE_API_KEY=
# "true" to offer Sign in with Microsoft
VITE_MICROSOFT_SIGN_IN=
# For local runs against the Auth emulator, e.g. 127.0.0.1:9099
VITE_AUTH_EMULATOR_HOST=
